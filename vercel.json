{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/studio/agents", "destination": "/studio/agents.html" },
    { "source": "/agents", "destination": "/studio/agents.html" },
    { "source": "/cockpit", "destination": "/studio/index.html" },
    { "source": "/atelier", "destination": "/atelier/decouverte.html" },
    { "source": "/atelier/decouverte", "destination": "/atelier/decouverte.html" },
    { "source": "/atelier/maturite", "destination": "/atelier/maturite.html" },
    { "source": "/entretien", "destination": "/atelier/decouverte.html" },
    { "source": "/maturite", "destination": "/atelier/maturite.html" },
    { "source": "/k/nouveau", "destination": "/k/nouveau.html" },
    { "source": "/k/:tag", "destination": "/k/index.html?t=:tag" }
  ],
  "headers": [
    {
      "source": "/k/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/k/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/atelier/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
